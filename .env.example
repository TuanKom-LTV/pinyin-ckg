# Sao chép file này thành .env rồi điền key. KHÔNG chia sẻ file .env.
# Nguồn AI: gemini (có gói miễn phí) hoặc claude (trả phí)
PINYIN_AI_PROVIDER=gemini
GEMINI_API_KEY=
# PINYIN_GEMINI_MODEL=gemini-3.5-flash
# PINYIN_GEMINI_BACKUP_MODEL=gemini-3.5-flash-lite
# ANTHROPIC_API_KEY=sk-ant-...
# PINYIN_AI_MODEL=claude-opus-5-5
# PINYIN_AI_CACHE_GIAY=60
# PINYIN_MAX_LOT=1.0
# PINYIN_ALLOW_REAL=0   # giữ 0: chỉ cho phép tài khoản Demo

# Tên cặp tiền trên sàn (thường KHÔNG cần đặt: PinYin tự dò hậu tố như XAUUSD.sc, XAUUSDm, GOLD, #XAUUSD...)
# Chỉ đặt khi tự dò sai. Xem kết quả dò tại /ckg/api/symbols
# SYMBOL_SUFFIX=.sc
# SYMBOL_MAP=XAUUSD=GOLD.sc,GBPUSD=GBPUSD.sc
